# PostgreSQL connection string.
DATABASE_URL=postgres://user@localhost:5432/health_overview

# Signs the session cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Password that opens the app. Authentication fails closed while this is empty.
APP_PASSWORD=

# Optional. Enables reading image-only reports, the written summary and recommendations.
# Use a key from a Console workspace with a monthly spend limit.
ANTHROPIC_API_KEY=

# Optional, tests only. `npm run test:db` defaults to the Docker database from
# docker-compose.test.yml and refuses any non-local host.
# TEST_DATABASE_URL=postgres://test:test@127.0.0.1:54329/health_overview_test
